# Ghostty config, kept close to wezterm/.config/wezterm/wezterm.lua
# Reference: https://ghostty.org/docs/config/reference

# Login fish shell. config.fish adds /opt/homebrew/bin to the PATH, so the
# PATH override in the WezTerm config is not needed here.
command = /opt/homebrew/bin/fish --login

# Nightfox rather than WezTerm's Catppuccin Mocha, to match Workbench
theme = Nightfox

font-family = JetBrainsMono Nerd Font
font-size = 12

# Slightly transparent and blurred background
background-opacity = 0.95
background-blur = 30

# Native macOS tabs sit at the top and are hidden while there is only one
# tab, matching tab_bar_at_bottom = false and hide_tab_bar_if_only_one_tab.

# Cmd+, opens this file in the default editor (Ghostty's built-in
# open_config binding). Ghostty cannot run a command in a new tab, so it
# does not open nvim the way the WezTerm binding does.
